# 把所有食物的美味值写入内存（共15个）
add|imm1|imm2 0 0 0

str 0 in 0
add|imm2 0 1 0
jb|imm2 0 15 4
# 排序
add|imm1|imm2 0 0 5
label for1
add|imm1|imm2 0 0 0

label for0
ldr 0 0 2
add|imm2 0 1 1
ldr 1 0 3

# if reg2 > reg3
ja 2 3 if0_true
je 0 0 if0_false

label if0_true
add|imm2 2 0 4
add|imm2 3 0 2
add|imm2 4 0 3
str 0 2 0
str 1 3 0

label if0_false
add|imm2 0 1 0
jb|imm2 0 14 for0

add|imm2 5 1 5
jb|imm2 5 15 for1

# 从小到大输出食物的美味值
add|imm1|imm2 0 0 0

ldr 0 0 7
add|imm2 0 1 0
jb|imm2 0 15 84