# r0 = max_height
add|imm1|imm2 0 0 0
# r1 = max_index
add|imm1|imm2 0 0 1

# r8 = index
add|imm1|imm2 0 0 8
label for
# r3 = in
add|imm2 in 0 3
str 8 3 _
jg 3 0 if
je 0 0 if_end
label if
	add|imm2 3 0 0
	add|imm2 8 0 1
label if_end
add|imm2 8 1 8
jl|imm2 8 16 for

# r3 = ptr
add|imm1|imm2 0 0 3
# r4 = Current_Level
add|imm1|imm2 0 0 4
# r5 = Total_Water
add|imm1|imm2 0 0 5

label for1
jl 3 1 if1
je 0 0 if1_end
label if1
	# r8 = H
	ldr 3 _ 8
	jg 8 4 if2
	je 0 0 if2_end
	label if2
		add|imm2 8 0 4
	label if2_end
	# r9 = current_water
	sub 4 8 9
	add 5 9 5
	add|imm2 3 1 3
	je 0 0 for1
label if1_end

add|imm1|imm2 15 0 3
add|imm1|imm2 0 0 4

label for2
jg 3 1 if3
je 0 0 if3_end
label if3
	# r8 = H
	ldr 3 _ 8
	jg 8 4 if4
	je 0 0 if4_end
	label if4
		add|imm2 8 0 4
	label if4_end
	# r9 = current_water
	sub 4 8 9
	add 5 9 5
	sub|imm2 3 1 3
	je 0 0 for2
label if3_end

add|imm2 5 0 out

label pause
je 0 0 pause